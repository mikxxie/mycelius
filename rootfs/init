#!/bin/sh
# mycelius init — starts UI stack on boot
# Runs as PID 1 inside QEMU (root), so sched_setscheduler works.

mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev || true
mkdir -p /var/run /var/log

echo "mycelius: starting UI stack"

/sbin/backboardd -s /var/run/lp_bb.sock > /var/log/bb.log 2>&1 &
sleep 1

if [ -S /var/run/lp_bb.sock ]; then
    /sbin/launchpad -b /var/run/lp_bb.sock -o /var/run/lp_frame.ppm > /var/log/lp.log 2>&1 &
    echo "mycelius: LaunchPad running"
else
    echo "mycelius: backboardd socket not found, launchpad skipped"
fi

# Keep init alive
while true; do sleep 3600; done
